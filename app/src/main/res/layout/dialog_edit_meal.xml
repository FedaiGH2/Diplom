<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/linear_bg_white">


    <TextView
        android:id="@+id/dialogProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Название продукта"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:id="@+id/dialogCaloriesText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Калории: 0"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_below="@id/dialogProductName"
        android:layout_marginTop="8dp"/>


    <TextView
        android:id="@+id/dialogProteinText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Белки: 0 г"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_below="@id/dialogCaloriesText"
        android:layout_marginTop="4dp"/>


    <TextView
        android:id="@+id/dialogFatText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Жиры: 0 г"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_below="@id/dialogProteinText"
        android:layout_marginTop="4dp"/>


    <TextView
        android:id="@+id/dialogCarbText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Углеводы: 0 г"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_below="@id/dialogFatText"
        android:layout_marginTop="4dp"/>


    <TextView
        android:id="@+id/dialogFiberText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Клетчатка: 0 г"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_below="@id/dialogCarbText"
        android:layout_marginTop="4dp"/>


    <EditText
        android:id="@+id/dialogGramsInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Граммы"
        android:textSize="20sp"
        android:gravity="center"
        android:inputType="numberDecimal"
        android:layout_below="@id/dialogFiberText"
        android:layout_marginTop="12dp"/>


    <Button
        android:id="@+id/dialogEditButton"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Изменить"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:layout_below="@id/dialogGramsInput"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true"
        android:backgroundTint="#FFD700"
        android:layout_marginStart="16dp"
        android:padding="8dp"/>
</RelativeLayout>
