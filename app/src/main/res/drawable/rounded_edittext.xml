<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Желтый фон -->
    <solid android:color="#F4A900" />

    <!-- Закругления -->
    <corners android:radius="30dp" />

    <!-- Обводка (можно оставить прозрачной или темно-желтой) -->
    <stroke
        android:width="1dp"
        android:color="#FFD700" />

    <!-- Внутренние отступы -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
</shape>
