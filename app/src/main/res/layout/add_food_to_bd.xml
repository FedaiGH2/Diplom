<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/linear_bg_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Заголовок -->
        <TextView
            android:id="@+id/dialogProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Введите данные на 100 г"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- Название продукта -->
        <EditText
            android:id="@+id/inputName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Название продукта"
            android:textSize="18sp"
            android:gravity="center"/>

        <!-- Калории -->
        <EditText
            android:id="@+id/inputCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Калории"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"
            android:gravity="center"/>

        <!-- Белки -->
        <EditText
            android:id="@+id/inputProtein"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Белки"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"
            android:gravity="center"/>

        <!-- Жиры -->
        <EditText
            android:id="@+id/inputFat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Жиры"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"
            android:gravity="center"/>

        <!-- Углеводы -->
        <EditText
            android:id="@+id/inputCarb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Углеводы"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"
            android:gravity="center"/>

        <!-- Клетчатка -->
        <EditText
            android:id="@+id/inputFiber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Клетчатка"
            android:layout_marginTop="8dp"
            android:inputType="numberDecimal"
            android:gravity="center"/>

        <!-- Кнопка Добавить -->
        <Button
            android:id="@+id/addProductBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FFD700"
            android:textSize="20sp"
            android:layout_marginTop="16dp"/>

        <!-- Кнопка Удалить (по умолчанию скрыта, видна только админ) -->
        <Button
            android:id="@+id/deleteProductBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Удалить"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FF0000"
            android:textSize="20sp"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>